    {
      "parameters": {
        "promptType": "define",
        "text": "=user query: {{ $('Edit Fields').item.json.userMessage }}",
        "needsFallback": true,
        "options": {
          "systemMessage": "You are the Weather Specialist.\n\nAlways use the Weather Tool.\n\nNever answer finance questions.\n\nNever answer calculator questions.\n\nWhen using weather tool, extract the city from the query, and pass it as \"city\" json field in the request body.",
          "maxIterations": 10
        }
      },
