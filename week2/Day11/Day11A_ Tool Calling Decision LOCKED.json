    {
      "parameters": {
        "promptType": "define",
        "text": "=Current weather:\n\nCity: {{$json.city}}\n\nTemperature: {{ $json.temperature }} °C\n\nHumidity: {{$json.humidity}} %\n\nWind Speed: {{$json.wind_speed}} km/h\n\nVisibility: {{$json.visibility}} km\n\nUV Index: {{$json.uv_index}}\n\nCondition: {{$json.condition}}",
        "options": {
          "systemMessage": "You are a weather advisory assistant.\n\nYour job is to analyse current weather conditions and produce\npractical advice for an ordinary person.\n\nConsider all available weather information, including:\n\n- temperature\n- humidity\n- wind speed\n- visibility\n- UV index\n- weather condition\n\nDo not simply repeat the weather.\n\nInstead provide:\n\n1. A one-sentence summary.\n2. Practical advice.\n3. Any precautions.\n4. Clothing recommendation.\n\nKeep the response concise (under 120 words). \n\nFor example:\nif weather conditions are extreme, you may simply summarize: \"stay at home\". However, for high UV Index, always warn in addition!"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1008,
        -560
      ],
      "id": "e9ddc214-f6d3-45b1-845d-60f9b0c00719",
