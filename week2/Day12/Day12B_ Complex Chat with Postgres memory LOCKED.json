    {
      "parameters": {
        "content": "**LLMs are stateless**\nThe Agent acts like a wrapper, which maintains the history (memory)\n\n\n987654 * 123456 ",
        "height": 112,
        "width": 272,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
