      "id": "bd3b1974-155f-41ea-8a9e-c7bea9bb084c",
      "name": "Calculator Tool",
      "notesInFlow": true,
      "notes": "Perform arithmetic calculations.\n\nUse this tool whenever the user asks for:\n\naddition\n\nsubtraction\n\nmultiplication\n\ndivision\n\npercentage\n\nsquare root\n\nmathematical expressions."
    },
