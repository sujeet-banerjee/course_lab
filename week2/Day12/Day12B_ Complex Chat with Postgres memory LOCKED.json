      ],
      "id": "dd6a31f0-cf0b-4d40-a0ef-29ac84252a5f",
      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "content": "```\n                POST Request\n                     │\n                Webhook Trigger\n                     │\n             AI Agent (Assistant)\n                     │\n      ┌──────────────┼───────────────┐\n      |              |               |\n                Memory \n            (Conv. History)\n \n```",
        "height": 256,
        "width": 512
      },
      "type": "n8n-nodes-base.stickyNote",
