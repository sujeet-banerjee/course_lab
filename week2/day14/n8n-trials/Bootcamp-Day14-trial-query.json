    {
      "parameters": {
        "toolDescription": "Weather Tool: Retrieves the current weather for a city.\n\nUse this tool whenever the user asks about:\n\nweather, temperature, humidity, forcast, Weather advice, rain, climate\n\nTOOL INPUT:\nThe input must be a json, with \"city\" field as mandatory, for example:\n  \n{\n \n\"city\": \"Bangalore\"\n}\n",
        "method": "POST",
        "url": "http://localhost:5678/webhook/weather2",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "city",
              "value": "={{ $fromAI('city', `supply the city field`, 'string') }}"
            }
          ]
        },
        "options": {}
      },
