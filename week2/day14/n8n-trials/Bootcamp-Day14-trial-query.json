    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=user query: {{ $json.body.userMessage }}",
        "options": {
          "systemMessage": "You are a routing agent.\n\nYour ONLY responsibility is deciding which specialist agent\nshould answer the question.\n\nAvailable specialists:\n\nweather\nfinance\ngeneral\n\nFinance includes:\n\n- date\n- time\n- duration\n- day of week\n- calculator\n- currency conversion\n- stock prices\n\n\nWeather includes:\n\n- temperature\n- humidity\n- forecast\n- rain\n- climate\n\nEverything else is general.\n\nReturn ONLY the valid String, that is one of \"weather\", \"finance\" or \"general\". And Return only one of the three outputs.\n\nExample:\n\"weather\"\n\nDo not explain.\n\nDo not answer the user's question."
        }
      },
