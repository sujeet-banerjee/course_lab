    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n    let tempterature = parseInt(item.json.temp_C)\n    if (tempterature > 35) {\n       item.json.advice = 'Stay indoors.';\n    } else if (tempterature > 25) {\n       item.json.advice = 'Carry water bottle';\n    } else {\n       item.json.advice = 'Enjoy weather!';\n    }\n    \n}\n\nreturn $input.all();"
