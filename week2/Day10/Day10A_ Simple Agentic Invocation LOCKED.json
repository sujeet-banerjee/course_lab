    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n\nconst temp =\n  parseInt(\n    $input.first().json.temperature\n  );\n\nlet advice;\nif (temp > 35)\n{\n  advice = \"Stay indoors\";\n}\nelse if (temp > 25)\n{\n  advice = \"Carry water\";\n}\nelse\n{\n  advice = \"Enjoy the weather\";\n}\n\nfor (const item of $input.all()) {\n  item.json.advice = advice;\n}\n\nreturn $input.all();"
      },
