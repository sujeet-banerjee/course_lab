    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  if(item.json.name == 'Sujeet') {\n    item.json.category = 'Trainer';\n  }\n  else if(item.json.experience >= 3) {\n    item.json.category = 'Experienced';\n    item.json.assigned_track = 'Track-A';\n  } else {\n    item.json.category = 'Beginner';\n    item.json.assigned_track = 'Track-B';\n  }\n}\n\nreturn $input.all();"
      },
