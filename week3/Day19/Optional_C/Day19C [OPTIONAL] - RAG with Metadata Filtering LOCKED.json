    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  if(item.json.file_metadata.fileName == 'Code_of_Conduct.pdf') {\n    item.json.file_metadata.department = 'Legal';\n  } else if (item.json.file_metadata.fileName == 'Employee_Handbook.pdf') {\n    item.json.file_metadata.department = 'HR';\n  } else if (item.json.file_metadata.fileName == 'IT_Security_Policy.pdf') {\n    item.json.file_metadata.department = 'Security';\n  } else if (item.json.file_metadata.fileName == 'Travel_Policy.pdf') {\n    item.json.file_metadata.department = 'Travel';\n  }\n}\n\nreturn $input.all();"
      },
