    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  const q = item.json.question.toLowerCase()\n  department = []\n  if (q.includes(\"travel\")) {\n    department.push('Travel')\n  }\n  if (q.includes(\"vpn\") || q.includes(\"laptop\")) {\n      department.push('Security')\n  }\n  if (q.includes(\"leave\")) {\n      department.push('HR')\n  }\n  if (q.includes(\"discrimination\") || \n      q.includes(\"harassment\")|| \n      q.includes(\"conflict\")|| \n      q.includes(\"gift\")|| \n      q.includes(\"confidentiality\")|| \n      q.includes(\"competitior\")) {\n      department.push('Legal')\n  }    \n  item.json.department = department;\n}\n\nreturn $input.all();"
      },
